{
  "name": "@ory-forms/react",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/semyonshap/ory-forms.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/semyonshap/ory-forms/issues"
  },
  "homepage": "https://github.com/semyonshap/ory-forms",
  "keywords": [
    "ory",
    "kratos",
    "authentication",
    "react",
    "identity",
    "forms"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@ory/client-fetch": "^1.22.0",
    "i18next": "^23.0.0 || ^24.0.0",
    "lodash-es": "^4.17.21",
    "react-hook-form": "^7.50.0",
    "react-i18next": "^14.0.0 || ^15.0.0",
    "usehooks-ts": "^3.0.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.0 || ^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.0"
  }
}
