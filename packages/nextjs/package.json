{
  "name": "@ory-forms/nextjs",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/semyonshap/ory-forms.git",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/semyonshap/ory-forms/issues"
  },
  "homepage": "https://github.com/semyonshap/ory-forms",
  "keywords": [
    "ory",
    "kratos",
    "authentication",
    "nextjs",
    "identity",
    "forms"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ory/client-fetch": "^1.22.0",
    "cookie": "^1.0.0",
    "lodash-es": "^4.17.21",
    "set-cookie-parser": "^2.7.0",
    "tldts": "^6.0.0"
  },
  "peerDependencies": {
    "@ory-forms/react": "workspace:^",
    "next": ">=13.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/lodash-es": "^4.17.0",
    "@types/set-cookie-parser": "^2.4.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.5.0"
  }
}
