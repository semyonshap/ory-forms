# E2E auth container env.
# Used at build time (inlined into client bundles via ENV_FILE) and at runtime
# (passed as -e to `docker run`). Single source of truth for the e2e auth app.

# Client + server public values (baked at build, also passed at runtime)
NEXT_PUBLIC_ORY_SDK_URL=http://localhost:8080
NEXT_PUBLIC_CAPTCHA_ENABLED=true
NEXT_PUBLIC_PROJECT_NAME=Ory Auth
NEXT_PUBLIC_PROJECT_DEFAULT_LOCALE=en
NEXT_PUBLIC_PROJECT_ENABLED_LOCALES=en
NEXT_PUBLIC_PROJECT_LOCALE_BEHAVIOR=force_default
NEXT_PUBLIC_HIDE_REGISTRATION_LINK=false
NEXT_PUBLIC_REGISTRATION_ENABLED=true
NEXT_PUBLIC_VERIFICATION_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only (runtime)
ORY_SDK_URL=http://kratos:4433
ORY_HYDRA_URL=http://hydra:4445
ORY_KETO_READ_URL=http://keto:4466
WEBHOOK_KEY=X-Webhook-Key
WEBHOOK_SECRET_KEY=super-webhook-secret-key
KETO_NAMESPACE=Group
KETO_RELATION=members
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
