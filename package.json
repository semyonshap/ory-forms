{
  "name": "@ory-forms",
  "private": true,
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:react": "nx run @ory-forms/react:build --skip-nx-cache",
    "build:nextjs": "nx run @ory-forms/nextjs:build --skip-nx-cache",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint:fix --all",
    "clean": "nx run-many --target=clean --all",
    "check-deps": "nx run-many --target=knip --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "format:check": "nx format:check --all",
    "format:write": "nx format:write --all",
    "release": "nx release",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/semyonshap/ory-forms.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@nx/eslint": "21.3.11",
    "@nx/js": "21.3.11",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.29.0",
    "nx": "21.3.11",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
