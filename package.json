{
  "name": "@ory-forms/monorepo",
  "private": true,
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:react": "nx run @ory-forms/react:build --skip-nx-cache",
    "build:nextjs": "nx run @ory-forms/nextjs:build --skip-nx-cache",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "clean": "nx run-many --target=clean --all",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\"",
    "release": "nx release",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/YOUR_USERNAME/ory-forms.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@nx/eslint": "21.3.11",
    "@nx/js": "21.3.11",
    "eslint": "^9.0.0",
    "nx": "21.3.11",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
