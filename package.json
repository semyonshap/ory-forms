{
  "name": "ory-forms",
  "private": true,
  "scripts": {
    "dev": "nx run-many -t dev --all --parallel",
    "dev:docker": "concurrently \"nx run-many -t dev --all\" \"nx run test:docker:up\" -n dev,docker -c blue,yellow",
    "build": "nx run-many -t build --all",
    "build:react": "nx run @ory-forms/react:build --skip-nx-cache",
    "build:nextjs": "nx run @ory-forms/nextjs:build --skip-nx-cache",
    "lint": "nx run-many -t lint --all",
    "lint:fix": "nx run-many -t lint:fix --all",
    "clean": "nx run-many -t clean --all",
    "knip": "nx run-many -t knip --all",
    "typecheck": "nx run-many -t typecheck --all",
    "format": "nx format:write --all",
    "test": "nx run-many -t test --all",
    "all": "pnpm format && nx run-many -t lint:fix typecheck knip --all",
    "pub": "pnpm all && pnpm build && pnpm -r publish --no-git-checks"
  },
  "packageManager": "pnpm@11.17.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/semyonshap/ory-forms.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^15.5.3",
    "@nx/eslint": "21.3.11",
    "@nx/js": "21.3.11",
    "concurrently": "^10.0.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.29.0",
    "nx": "21.3.11",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
